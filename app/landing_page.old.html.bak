<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="theme-color" content="#000000">
  <meta name="description" content="AI Talent Match·Pro — Deep-thinking candidate intelligence and enterprise-grade hiring automation, powered by GPT-4o on Azure.">
  <meta name="keywords" content="AI recruiting, talent matching, HR AI, candidate scoring, enterprise hiring">
  <meta name="author" content="AI Talent Match·Pro">
  <meta name="robots" content="index, follow">
  <meta property="og:title" content="AI Talent Match·Pro — Hire faster. Stay in control.">
  <meta property="og:description" content="Enterprise-grade AI scoring and hiring intelligence. Powered by GPT-4o on Azure.">
  <meta property="og:image" content="/static/og-image.png">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://aitmp.io">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="AI Talent Match·Pro">
  <meta name="twitter:description" content="Enterprise AI scoring for HR teams.">
  <meta name="twitter:image" content="/static/og-image.png">
  <link rel="icon" href="/static/at-hexagon.png">
  <link rel="apple-touch-icon" href="/static/at-hexagon.png">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "AI Talent Match·Pro",
    "description": "Enterprise-grade AI candidate scoring and hiring intelligence platform.",
    "url": "https://aitmp.io",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web, iOS, Android",
    "offers": {"@type": "Offer","price": "0","priceCurrency": "USD"},
    "provider": {"@type": "Organization","name": "AI Talent Match·Pro","url": "https://aitmp.io"}
  }
  </script>
  <title>AI Talent Match·Pro</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/styles.css" />
<style>
html { scroll-behavior: smooth; }
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --g-blue: #1a6df5; --g-blue-mid: #2979ff; --g-blue-glow: rgba(26,109,245,0.3);
  --g-muted: rgba(255,255,255,0.5); --g-border: rgba(255,255,255,0.07);
}
html, body { background: #050914 !important; color: #fff !important; font-family: 'Inter', -apple-system, sans-serif; }

/* NAVBAR */
.top-nav { position: fixed !important; top:0; left:0; width:100%; height:64px; padding:0 48px; display:flex; align-items:center; justify-content:space-between; background:rgba(5,9,20,0.95) !important; backdrop-filter:blur(20px); border-bottom:1px solid rgba(255,255,255,0.07); z-index:9999; }
.nav-left { display:flex; align-items:center; }
.nav-right { display:flex; align-items:center; gap:28px; }
.logo-img { width:48px; height:48px; object-fit:contain; }
.logo-visible { display:block; } .logo-hidden { display:none; }
.nav-link { font-size:14px; font-weight:500; color:rgba(255,255,255,0.65); text-decoration:none; transition:color 0.2s; }
.nav-link:hover { color:#fff; }
.nav-cta { padding:8px 18px; background:#2563eb !important; color:#fff; font-size:14px; font-weight:600; border-radius:8px; text-decoration:none; }

/* HERO */
#hero { position:relative; min-height:100vh; width:100%; display:flex; align-items:center; justify-content:center; text-align:center; overflow:hidden; background-color:#050914; }
.hero-content { position:relative; z-index:3; padding-top:64px; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:100vh; padding-bottom:80px; }
.hero-at-logo { width:80px; height:80px; background:linear-gradient(135deg,#1a6df5,#4d9fff); border-radius:18px; display:flex; align-items:center; justify-content:center; font-size:26px; font-weight:900; color:#fff; margin:0 auto 22px; box-shadow:0 0 50px rgba(37,99,235,0.7); }
.hero-title { font-size:clamp(32px,5vw,52px); font-weight:800; color:#fff; margin-bottom:10px; letter-spacing:-0.02em; }
.hero-sub { font-size:20px; font-weight:500; color:rgba(180,210,255,0.85); margin-bottom:4px; }
.hero-wave { width:100%; max-width:700px; display:block; margin:28px auto; }
.primary-button { background:#2563eb !important; color:#fff; border:none; border-radius:999px; padding:16px 40px; font-size:16px; font-weight:700; cursor:pointer; box-shadow:0 0 50px rgba(37,99,235,0.5); transition:background 0.2s, transform 0.15s; font-family:'Inter',sans-serif; }
.primary-button:hover { background:#1d4ed8 !important; transform:translateY(-2px); }

/* TRUST BAND */
.trust-band { background:#050914; border-top:1px solid rgba(255,255,255,0.06); border-bottom:1px solid rgba(255,255,255,0.06); padding:18px 40px; position:relative; z-index:2; }
.trust-band-inner { max-width:1080px; margin:0 auto; display:flex; align-items:center; justify-content:center; gap:16px; flex-wrap:wrap; font-size:13px; font-weight:500; color:rgba(255,255,255,0.42); letter-spacing:0.02em; }

/* SECTIONS */
section { position:relative; overflow:visible; }
#how-it-works, #human-story, .human-story-section, .tiers-section, .api-section, .demo-section, .pricing-section, #final-cta { background:#050914 !important; }

.section-stars {
  background-image: radial-gradient(1px 1px at 10% 15%, rgba(255,255,255,0.55) 0%, transparent 100%), radial-gradient(1px 1px at 25% 40%, rgba(255,255,255,0.4) 0%, transparent 100%), radial-gradient(1px 1px at 40% 70%, rgba(255,255,255,0.5) 0%, transparent 100%), radial-gradient(1px 1px at 55% 20%, rgba(255,255,255,0.45) 0%, transparent 100%), radial-gradient(1px 1px at 70% 55%, rgba(255,255,255,0.4) 0%, transparent 100%), radial-gradient(1px 1px at 82% 30%, rgba(255,255,255,0.55) 0%, transparent 100%), radial-gradient(1px 1px at 92% 75%, rgba(255,255,255,0.4) 0%, transparent 100%) !important;
}
.section-fog::after { content:""; position:absolute; bottom:-60px; left:50%; transform:translateX(-50%); width:700px; height:180px; background:radial-gradient(ellipse at 50% 50%, rgba(0,120,160,0.35) 0%, rgba(0,80,120,0.15) 50%, transparent 75%); pointer-events:none; z-index:1; }

/* HOW IT WORKS */
#how-it-works { padding:100px 0 80px; }
.how-section { padding:0 48px; max-width:1080px; margin:0 auto; }
.section-eyebrow { text-align:center; font-size:12px; font-weight:600; color:#4d9fff !important; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:14px; }
.section-heading { text-align:center; font-size:clamp(26px,3.8vw,42px); font-weight:800; color:#fff; letter-spacing:-0.025em; margin-bottom:10px; }
.section-sub { text-align:center; font-size:16px; color:rgba(255,255,255,0.5); max-width:500px; margin:0 auto 56px; line-height:1.65; }
.steps-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:0; }
.step-card { padding:44px 34px; transition:background 0.2s; border-right:1px solid rgba(255,255,255,0.06); }
.step-card:last-child { border-right:none; }
@media (max-width:700px) {
  .steps-grid { grid-template-columns:1fr !important; gap:0 !important; }
  .step-card { border-right:none !important; border-bottom:1px solid rgba(255,255,255,0.06); padding:32px 24px !important; }
  .step-card:last-child { border-bottom:none; }
}
.step-number { font-size:11px; font-weight:700; color:#4d9fff !important; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:18px; }
.step-icon { width:46px; height:46px; border-radius:11px; display:flex; align-items:center; justify-content:center; margin-bottom:18px; }
.step-icon-1 { background:rgba(37,99,235,0.14); } .step-icon-2 { background:rgba(139,92,246,0.14); } .step-icon-3 { background:rgba(6,182,212,0.14); }
.step-title { font-size:17px; font-weight:700; color:#fff; margin-bottom:9px; }
.step-desc { font-size:14px; color:rgba(255,255,255,0.5); line-height:1.6; }

/* HUMAN STORY */
#human-story, .human-story-section { min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:100px 40px; }
.human-title { font-size:clamp(32px,5vw,52px); font-weight:800; line-height:1.2; color:#fff; margin-bottom:24px; max-width:700px; }
.human-text { font-size:18px; color:rgba(255,255,255,0.65); line-height:1.7; max-width:560px; }

/* TIERS */
.tiers-section { padding:100px 40px; }
.tiers-header { text-align:center; margin-bottom:56px; position:relative; z-index:1; }
.tiers-eyebrow { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.14em; color:#4d9fff !important; margin-bottom:14px; }
.tiers-title { font-size:clamp(28px,4vw,44px); font-weight:800; color:#fff; line-height:1.2; margin-bottom:14px; }
.tiers-sub { font-size:16px; color:rgba(255,255,255,0.5); max-width:500px; margin:0 auto; line-height:1.6; }
.bento-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; max-width:1080px; margin:0 auto; position:relative; z-index:1; }
.bento-card { padding:44px 20px; display:flex; flex-direction:column; align-items:center; gap:6px; transition:all 0.25s; text-align:center; border:none; }
.bento-card.gold-card { border:none; }
.bento-card.silver-card { border:none; }
.bento-card.bronze-card { border:none; }
.bento-card:hover { transform:translateY(-4px); }
.tier-medal-emoji { font-size:52px; line-height:1; margin-bottom:8px; }
.tier-match-pct { font-size:52px; font-weight:800; color:#fff; line-height:1; }
.tier-match-label { font-size:20px; font-weight:700; color:#fff; }
.tier-persona-name { font-size:15px; font-weight:700; margin-top:4px; }
.gold-card .tier-persona-name { color:#f5c542; }
.silver-card .tier-persona-name { color:#c0c6d8; }
.bronze-card .tier-persona-name { color:#d58a55; }
.tier-desc { font-size:13px; color:rgba(255,255,255,0.5); line-height:1.5; margin-top:8px; }
.tier-badge { display:inline-block; margin-top:14px; padding:4px 14px; border-radius:999px; font-size:11px; font-weight:700; }
.gold-card .tier-badge { background:rgba(245,197,66,0.1); border:1px solid rgba(245,197,66,0.3); color:#f5c542; }
.silver-card .tier-badge { background:rgba(192,198,216,0.08); border:1px solid rgba(192,198,216,0.2); color:#c0c6d8; }
.bronze-card .tier-badge { background:rgba(213,138,85,0.08); border:1px solid rgba(213,138,85,0.2); color:#d58a55; }
.tiers-bottom { text-align:center; margin-top:48px; font-size:14px; color:rgba(255,255,255,0.35); position:relative; z-index:1; }

/* API SECTION */
.api-section { padding:80px 40px; }
.api-inner { max-width:1080px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; position:relative; z-index:1; }
.api-eyebrow { font-size:11px; font-weight:700; color:#4d9fff !important; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:12px; }
.api-title { font-size:28px; font-weight:800; color:#fff; letter-spacing:-0.02em; margin-bottom:12px; line-height:1.2; }
.api-sub { font-size:14px; color:rgba(255,255,255,0.45); line-height:1.7; margin-bottom:20px; }
.api-tags { display:flex; gap:8px; flex-wrap:wrap; }
.api-tag { font-size:11px; font-weight:600; padding:4px 10px; border-radius:999px; border:1px solid rgba(41,182,246,0.3); color:#4d9fff !important; background:rgba(41,182,246,0.08); }
.api-code-wrap { background:#07111f; border:1px solid rgba(255,255,255,0.07); border-radius:14px; overflow:hidden; }
.api-code-header { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.06); }
.api-code-title { font-size:12px; color:rgba(255,255,255,0.4); font-family:monospace; }
.api-code-dot { display:flex; gap:6px; }
.api-code-dot span { width:10px; height:10px; border-radius:50%; }
.dot-r { background:#ff5f57; } .dot-y { background:#febc2e; } .dot-g { background:#28c840; }
.api-code-body { padding:20px; font-family:'Courier New',monospace; font-size:12px; line-height:1.8; overflow-x:auto; }
.c-key { color:#79b8ff; } .c-str { color:#9ecbff; } .c-num { color:#79c0ff; }
.c-bool { color:#56d364; } .c-tier { color:#4d9fff; } .c-muted { color:rgba(255,255,255,0.25); }

/* PRICING */
.pricing-section { padding:100px 40px 80px; }
.pricing-hero { text-align:center; margin-bottom:48px; position:relative; z-index:1; }
.pricing-title { font-size:56px; font-weight:800; color:#fff; margin-bottom:12px; letter-spacing:-0.02em; }
.pricing-sub { font-size:20px; color:rgba(255,255,255,0.65); margin-bottom:6px; }
.pricing-sub2 { font-size:14px; color:rgba(255,255,255,0.38); margin-bottom:32px; }
.billing-toggle { display:inline-flex; align-items:center; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); border-radius:999px; padding:4px; gap:2px; }
.toggle-btn { padding:8px 20px; border-radius:999px; font-size:14px; font-weight:500; cursor:pointer; color:rgba(255,255,255,0.4); border:none; background:none; font-family:'Inter',sans-serif; transition:all 0.2s; }
.toggle-btn.active { background:#2563eb !important; color:#fff; font-weight:600; }
.discount-badge { background:rgba(37,99,235,0.2); border:1px solid rgba(37,99,235,0.4); color:#3b82f6; font-size:12px; font-weight:700; padding:3px 8px; border-radius:999px; margin-left:4px; }
.plans-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; max-width:1080px; margin:0 auto; position:relative; z-index:1; }
.plan-card { background:rgba(10,20,50,0.7) !important; border:1px solid rgba(37,99,235,0.25); border-radius:18px; padding:28px 22px; position:relative; transition:all 0.25s; backdrop-filter:blur(10px); }
.plan-card:hover { border-color:rgba(37,99,235,0.6); transform:translateY(-4px); box-shadow:0 0 40px rgba(37,99,235,0.2); }
.plan-card.popular { border-color:#2563eb !important; box-shadow:0 0 30px rgba(37,99,235,0.25) !important; }
.popular-badge { position:absolute; top:-13px; left:50%; transform:translateX(-50%); background:#2563eb !important; color:#fff; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; padding:4px 14px; border-radius:999px; white-space:nowrap; }
.plan-name { font-size:24px; font-weight:700; color:#fff; margin-bottom:6px; }
.plan-trial-badge { display:inline-block; background:#2563eb !important; color:#fff; font-size:10px; font-weight:600; padding:3px 10px; border-radius:999px; margin-bottom:10px; }
.plan-divider { height:1px; background:rgba(255,255,255,0.1); margin:12px 0; }
.plan-price { font-size:44px; font-weight:800; color:#fff; line-height:1; margin-bottom:4px; }
.plan-price sup { font-size:22px; font-weight:700; vertical-align:top; margin-top:8px; }
.plan-price .per { font-size:17px; font-weight:500; color:rgba(255,255,255,0.6); }
.plan-price-sub { font-size:12px; color:rgba(255,255,255,0.35); margin-bottom:18px; }
.plan-features { list-style:none; margin-bottom:22px; display:flex; flex-direction:column; gap:9px; }
.plan-features li { display:flex; align-items:center; gap:9px; font-size:14px; color:rgba(255,255,255,0.65); }
.check-icon { width:17px; height:17px; border-radius:50%; background:rgba(37,99,235,0.15); border:1px solid rgba(37,99,235,0.4); display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:9px; color:#3b82f6; }
.plan-btn { width:100%; padding:12px; border-radius:999px; font-size:15px; font-weight:600; cursor:pointer; border:none; font-family:'Inter',sans-serif; transition:all 0.2s; }
.btn-blue { background:#2563eb !important; color:#fff; box-shadow:0 4px 20px rgba(37,99,235,0.35); }
.btn-blue:hover { background:#3b82f6 !important; transform:translateY(-1px); }
.btn-outline-white { background:transparent; color:#fff; border:1px solid rgba(255,255,255,0.3); }
.btn-outline-white:hover { border-color:#fff; background:rgba(255,255,255,0.05); }

/* TOAST */
.toast { position:fixed; bottom:32px; right:32px; background:#1a2a4a; border:1px solid rgba(37,99,235,0.3); color:#fff; font-size:14px; font-weight:500; padding:14px 20px; border-radius:12px; z-index:99999; transform:translateY(80px); opacity:0; transition:all 0.3s cubic-bezier(0.16,1,0.3,1); }
.toast.show { transform:translateY(0); opacity:1; }
.toast.success { border-color:rgba(0,214,143,0.4); }
.toast.error { border-color:rgba(239,68,68,0.4); }

/* COOKIE */
.cookie-banner { position:fixed; bottom:0; left:0; right:0; background:#07111f; border-top:1px solid rgba(255,255,255,0.08); padding:16px 40px; display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap; z-index:9998; transform:translateY(100%); opacity:0; transition:transform 0.4s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease; }
.cookie-banner.show { transform:translateY(0); opacity:1; }
.cookie-text { font-size:13px; color:rgba(255,255,255,0.55); max-width:600px; line-height:1.5; }
.cookie-text a { color:#60a5fa; }
.cookie-btns { display:flex; gap:10px; }
.cookie-accept { padding:8px 20px; background:#2563eb !important; border:none; border-radius:8px; color:#fff; font-size:13px; font-weight:600; cursor:pointer; }
.cookie-decline { padding:8px 16px; background:transparent; border:1px solid rgba(255,255,255,0.2); border-radius:8px; color:rgba(255,255,255,0.6); font-size:13px; cursor:pointer; }

/* DEMO */
.demo-section { padding:80px 48px; }
.demo-inner { max-width:960px; margin:0 auto; position:relative; z-index:1; }
.demo-box { background:rgba(5,9,20,0.8); border:1px solid rgba(255,255,255,0.07); border-radius:16px; padding:32px; }
.demo-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:18px; }
.demo-field label { display:block; font-size:11px; font-weight:600; color:rgba(255,255,255,0.5); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:7px; }
.demo-field textarea { width:100%; height:96px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:10px; color:#fff; font-size:13px; font-family:'Inter',sans-serif; padding:11px 13px; resize:none; transition:border-color 0.2s; }
.demo-field textarea:focus { outline:none; border-color:rgba(37,99,235,0.48); }
.demo-run-btn { width:100%; padding:13px; background:#2563eb !important; color:#fff; font-size:15px; font-weight:600; border:none; border-radius:10px; cursor:pointer; font-family:'Inter',sans-serif; box-shadow:0 4px 20px rgba(37,99,235,0.3); }
.demo-run-btn:hover { background:#1d4ed8 !important; }
.demo-result { margin-top:22px; display:none; }
.demo-result.visible { display:block; animation:fadein 0.4s ease; }
@keyframes fadein { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
.demo-result-grid { display:grid; grid-template-columns:auto 1fr; gap:18px; background:rgba(37,99,235,0.06); border:1px solid rgba(37,99,235,0.18); border-radius:13px; padding:22px; align-items:start; }
.demo-score-circle { width:76px; height:76px; border-radius:50%; background:linear-gradient(135deg,#2563eb,#8b5cf6); display:flex; align-items:center; justify-content:center; font-size:24px; font-weight:900; color:#fff; flex-shrink:0; }
.demo-result-dims { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:10px; }
.demo-dim-chip { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:8px; padding:8px 11px; font-size:12px; }
.demo-dim-chip .chip-lbl { color:rgba(255,255,255,0.5); margin-bottom:2px; }
.demo-dim-chip .chip-val { color:#fff; font-weight:600; }
.demo-just { margin-top:13px; font-size:13px; color:rgba(255,255,255,0.58); line-height:1.6; font-style:italic; padding:11px 13px; background:rgba(6,182,212,0.05); border:1px solid rgba(6,182,212,0.11); border-radius:8px; }

/* ANIMATIONS */
.fade-in-up { opacity:0; transform:translateY(32px); transition:opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1); }
.fade-in-up.visible { opacity:1; transform:translateY(0); }

/* FOOTER */
footer { background:#07111f !important; }

/* SCROLLBAR */
::-webkit-scrollbar { width:6px; }
::-webkit-scrollbar-track { background:#050914; }
::-webkit-scrollbar-thumb { background:rgba(37,99,235,0.4); border-radius:999px; }

/* RESPONSIVE */
/* ── TABLET 768px ── */
@media (max-width:768px) {
  .top-nav { padding:0 20px !important; }
  .nav-right { gap:12px !important; }
  .nav-link { font-size:12px !important; }
  .demo-grid { grid-template-columns:1fr !important; }
  .api-inner { grid-template-columns:1fr 1fr !important; gap:14px !important; }
  .api-code-wrap { border-radius:10px !important; }
  .api-code-body { font-size:9px !important; padding:10px !important; line-height:1.6 !important; }
  .api-code-header { padding:8px 10px !important; }
  .api-code-title { font-size:10px !important; }
  .api-code-dot span { width:7px !important; height:7px !important; }
  .api-title { font-size:18px !important; line-height:1.2 !important; }
  .api-eyebrow { font-size:9px !important; margin-bottom:8px !important; }
  .api-sub { font-size:11px !important; line-height:1.5 !important; margin-bottom:12px !important; }
  .api-tag { font-size:9px !important; padding:2px 7px !important; }
  .api-tags { gap:5px !important; flex-wrap:wrap !important; }
  .steps-grid { grid-template-columns:1fr !important; gap:0 !important; }
  .step-card { border-right:none !important; border-bottom:1px solid rgba(255,255,255,0.06) !important; padding:28px 24px !important; }
  .step-card:last-child { border-bottom:none !important; }
  .bento-grid { grid-template-columns:1fr !important; gap:16px !important; max-width:380px !important; margin:0 auto !important; }
  .bento-card { padding:32px 24px !important; }
  .plans-grid { grid-template-columns:repeat(2,1fr) !important; gap:12px !important; }
  .pricing-title { font-size:36px !important; }
  .hero-content { padding:80px 20px 40px !important; }
  .how-section { padding:0 20px !important; }
  .api-section { padding:40px 16px !important; }
  .demo-section { padding:60px 20px !important; }
  .tiers-section { padding:60px 20px !important; }
  #human-story, .human-story-section { padding:60px 20px !important; min-height:auto !important; }
}

/* ── MOBILE 480px ── */
@media (max-width:480px) {
  .top-nav { padding:0 16px !important; height:56px !important; }
  .nav-right .nav-link { display:none !important; }
  .nav-right .nav-link:last-of-type { display:block !important; }
  .logo-img { width:36px !important; height:36px !important; }
  #nav-brand-text { font-size:13px !important; }
  .hero-content { padding:70px 16px 32px !important; }
  .hero-at-logo { width:56px !important; height:56px !important; }
  .steps-grid { grid-template-columns:1fr !important; }
  .step-card { padding:24px 16px !important; }
  .step-title { font-size:16px !important; }
  .step-desc { font-size:13px !important; }
  .bento-grid { grid-template-columns:1fr !important; max-width:100% !important; }
  .plans-grid { grid-template-columns:1fr !important; gap:12px !important; }
  .plan-card { padding:22px 18px !important; }
  .pricing-title { font-size:30px !important; }
  .pricing-sub { font-size:16px !important; }
  .human-title { font-size:26px !important; }
  .human-text { font-size:15px !important; }
  .tiers-title { font-size:22px !important; }
  .api-title { font-size:22px !important; }
  .section-heading { font-size:22px !important; }
  .trust-band-inner { gap:8px !important; font-size:11px !important; flex-wrap:wrap !important; justify-content:center !important; }
  footer { padding:40px 16px 0 !important; }
  footer .nav-right { flex-wrap:wrap !important; }
  .cookie-banner { padding:14px 16px !important; }
  .primary-button { padding:13px 28px !important; font-size:14px !important; }
  h1 { font-size:clamp(28px,7vw,40px) !important; }
}

@keyframes blink { 0%,100% { opacity:1; } 50% { opacity:0.3; } }

section { border:none !important; outline:none !important; }
#how-it-works, #human-story, .human-story-section, .tiers-section, .api-section, .demo-section, .pricing-section, #final-cta { border-top:none !important; border-bottom:none !important; overflow:visible !important; position:relative !important; }
#how-it-works::before, .tiers-section::before, .pricing-section::before { content:''; position:absolute; top:-80px; left:50%; transform:translateX(-50%); width:800px; height:160px; background:radial-gradient(ellipse at 50% 50%, rgba(0,140,180,0.2) 0%, transparent 70%); pointer-events:none; z-index:1; }
</style>
</head>
<body>

<!-- NAV -->
<nav class="top-nav">
  <div class="nav-left">
    <a href="#hero" style="display:flex;align-items:center;gap:10px;text-decoration:none;">
      <img src="/static/at-hexagon.png" id="logo-default" style="width:36px;height:36px;object-fit:contain;flex-shrink:0;" alt="AT"
        onerror="this.outerHTML='<div style='width:36px;height:36px;background:linear-gradient(135deg,#1d6ef5,#4d9fff);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:900;color:#fff;'>AT</div>'">
      <span id="nav-brand-text" style="font-size:14px;font-weight:600;color:rgba(255,255,255,0.9);letter-spacing:0.01em;font-family:'Inter',sans-serif;transition:opacity 0.3s;">AI Talent Match·Pro</span>
    </a>
  </div>
  <div class="nav-right">
    <a href="#how-it-works" class="nav-link">How it works</a>
    <a href="#demo" class="nav-link">Live Demo</a>
    <a href="#pricing" class="nav-link">Pricing</a>
    <a href="/login" class="nav-link">Sign In</a>
    <a href="/register" class="nav-cta">Register</a>
  </div>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="hero-content">

    <!-- AT Hexagon Logo -->
    <img src="/static/at-hexagon.png" alt="AI Talent Match·Pro"
         style="width:80px;height:80px;object-fit:contain;margin-bottom:22px;filter:drop-shadow(0 0 30px rgba(37,99,235,0.7));"
         onerror="this.outerHTML='<div style='width:80px;height:80px;background:linear-gradient(135deg,#1a6df5,#4d9fff);border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:900;color:#fff;margin:0 auto 22px;box-shadow:0 0 40px rgba(37,99,235,0.7);'>AT</div>'" />

    <!-- Brand name -->
    <div style="font-size:15px;font-weight:700;color:rgba(255,255,255,0.5);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:12px;">AI Talent Match·Pro</div>

    <!-- Main headline -->
    <h1 style="font-size:clamp(36px,5.5vw,62px);font-weight:800;line-height:1.1;letter-spacing:-0.025em;margin-bottom:24px;">
      <span style="color:#fff;">Hire faster. </span><span style="background:linear-gradient(90deg,#4d9fff,#8b5cf6);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;">Stay in control.</span>
    </h1>

    <!-- Short explanation -->
    <p style="font-size:17px;color:rgba(255,255,255,0.55);line-height:1.7;max-width:520px;margin:0 auto 32px;">
      An AI recruiting platform that scores your candidates against the role, ranks your strongest matches Gold, Silver and Bronze, and writes personalised outreach ready to send.
    </p>

    <!-- Wave -->
    <svg class="hero-wave" viewBox="0 0 800 140" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="wg" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#0050A0;stop-opacity:0"/><stop offset="25%" style="stop-color:#1a6df5;stop-opacity:0.8"/><stop offset="50%" style="stop-color:#60C8FF;stop-opacity:1"/><stop offset="75%" style="stop-color:#1a6df5;stop-opacity:0.8"/><stop offset="100%" style="stop-color:#0050A0;stop-opacity:0"/></linearGradient>
        <linearGradient id="wg2" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#003080;stop-opacity:0"/><stop offset="50%" style="stop-color:#4d9fff;stop-opacity:0.45"/><stop offset="100%" style="stop-color:#003080;stop-opacity:0"/></linearGradient>
        <linearGradient id="bf" x1="0" y1="0" x2="0" y2="1"><stop offset="40%" style="stop-color:transparent"/><stop offset="100%" style="stop-color:#050914"/></linearGradient>
      </defs>
      <path d="M0,110 C80,90 160,118 260,94 C360,70 440,102 540,78 C620,60 670,88 800,72 L800,140 L0,140 Z" fill="url(#wg2)" opacity="0.4"/>
      <path d="M0,92 C70,68 148,98 240,74 C332,50 420,82 510,58 C600,34 660,66 800,48 L800,140 L0,140 Z" fill="url(#wg)" opacity="0.85"/>
      <path d="M0,92 C70,68 148,98 240,74 C332,50 420,82 510,58 C600,34 660,66 800,48" fill="none" stroke="#90E8FF" stroke-width="2" opacity="0.95"/>
      <circle cx="240" cy="74" r="3.5" fill="#C0F8FF" opacity="1"/>
      <circle cx="510" cy="58" r="4" fill="#D0FFFF" opacity="1"/>
      <circle cx="375" cy="72" r="2" fill="#90E8FF" opacity="0.9"/>
      <rect width="800" height="140" fill="url(#bf)" opacity="0.65"/>
    </svg>

    <!-- Buttons -->
    <div style="display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap;margin-bottom:20px;">
      <button class="primary-button fade-in-up visible" onclick="window.location='/register'" style="border-radius:999px;padding:16px 40px;font-size:16px;box-shadow:0 0 60px rgba(37,99,235,0.6);">Start Free Trial →</button>
      <button onclick="document.getElementById('demo').scrollIntoView({behavior:'smooth'})" style="padding:16px 32px;background:transparent;border:1px solid rgba(255,255,255,0.2);border-radius:999px;color:rgba(255,255,255,0.7);font-size:15px;font-weight:600;cursor:pointer;font-family:inherit;transition:all 0.2s;" onmouseover="this.style.borderColor='rgba(255,255,255,0.5)';this.style.color='#fff'" onmouseout="this.style.borderColor='rgba(255,255,255,0.2)';this.style.color='rgba(255,255,255,0.7)'">See Live Demo</button>
    </div>

    <!-- Trust line -->
    <div style="font-size:12px;color:rgba(255,255,255,0.3);">Card required &nbsp;·&nbsp; Free for 7 days &nbsp;·&nbsp; Cancel anytime before day 7</div>

  </div>
</section>

<!-- TRUST BAND -->
<div class="trust-band">
  <div class="trust-band-inner">
    <span style="display:inline-flex;align-items:center;gap:7px;"><span style="width:14px;height:14px;background:#0078d4;border-radius:3px;display:inline-flex;align-items:center;justify-content:center;font-size:8px;font-weight:800;color:#fff;">A</span> Powered by Azure OpenAI</span>
    <span style="color:rgba(255,255,255,0.18);">&bull;</span>
    <span>GPT-4o</span>
    <span style="color:rgba(255,255,255,0.18);">&bull;</span>
    <span>Enterprise-grade security</span>
  </div>
</div>

<!-- HOW IT WORKS -->
<section id="how-it-works" class="section-fog section-stars">
  <div class="how-section fade-in-up">
    <p class="section-eyebrow">How it works</p>
    <h2 class="section-heading">From job description to ranked shortlist</h2>
    <p class="section-sub">Three steps. One search. A shortlist that actually reflects who will succeed in the role.</p>
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-number">Step 01</div>
        <div class="step-icon step-icon-1"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4d9fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg></div>
        <div class="step-title">Paste your job description</div>
        <div class="step-desc">Paste your job description in plain English. Tell us the role, the team, and what matters — our AI handles the rest.</div>
      </div>
      <div class="step-card">
        <div class="step-number">Step 02</div>
        <div class="step-icon step-icon-2"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8L12 3z"/><path d="M19 14l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8z"/></svg></div>
        <div class="step-title">AI scores every dimension</div>
        <div class="step-desc">Our deep-thinking engine scores fit, adaptability, focus penalty, and growth pattern — not just keyword matching.</div>
      </div>
      <div class="step-card">
        <div class="step-number">Step 03</div>
        <div class="step-icon step-icon-3"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg></div>
        <div class="step-title">Get your ranked shortlist</div>
        <div class="step-desc">Receive scores, dimensions, and natural language justification for every candidate — with personalised outreach messages ready to send.</div>
      </div>
    </div>
  </div>
</section>

<!-- HUMAN STORY -->
<section id="human-story" class="human-story-section section-fog section-stars">
  <h2 class="human-title">Beyond Keywords —<br>Into the Human Story</h2>
  <p class="human-text">Your team isn't built on résumés — it's built on people.<br>Our Deep‑Thinking Engine studies adaptability, growth patterns,<br>and how candidates think in real situations.</p>
</section>

<!-- TIER CARDS -->
<section class="tiers-section section-fog section-stars">
  <div class="tiers-header fade-in-up">
    <p class="tiers-eyebrow">Deep-Thinking Match Tiers</p>
    <h2 class="tiers-title">How we rank your candidates</h2>
    <p class="tiers-sub">Every AI search surfaces exactly three tiers — so you always know who to call first.</p>
  </div>
  <div class="bento-grid">
    <div class="bento-card gold-card">
      <div class="tier-medal-emoji">🥇</div>
      <div class="tier-match-pct">100%</div>
      <div class="tier-match-label">Match</div>
      <div class="tier-persona-name">The Perfect Soul</div>
      <span class="tier-badge">PAID PLANS</span>
    </div>
    <div class="bento-card silver-card">
      <div class="tier-medal-emoji">🥈</div>
      <div class="tier-match-pct">90%</div>
      <div class="tier-match-label">Match</div>
      <div class="tier-persona-name">The Mirror</div>
      <span class="tier-badge">Free Search</span>
    </div>
    <div class="bento-card bronze-card">
      <div class="tier-medal-emoji">🥉</div>
      <div class="tier-match-pct">80%</div>
      <div class="tier-match-label">Match</div>
      <div class="tier-persona-name">The Adjacent</div>
      <span class="tier-badge">Free Search</span>
    </div>
  </div>
  <p class="tiers-bottom">Our AI goes deeper than keywords to find the adaptability your team needs.</p>
</section>

<!-- API SECTION -->
<section class="api-section section-fog section-stars">
  <div class="api-inner">
    <div class="api-left">
      <div class="api-eyebrow">Enterprise API</div>
      <div class="api-title">One call.<br>Full intelligence.</div>
      <div class="api-sub">Send us your candidates and the role. We score every one against your requirements and return them ranked — with reasoning, silent skills, and personalised outreach messages ready to send.</div>
      <div class="api-tags">
        <span class="api-tag">REST API</span>
        <span class="api-tag">JSON</span>
        <span class="api-tag">Azure OpenAI</span>
        <span class="api-tag">Real-time</span>
      </div>
    </div>
    <div class="api-code-wrap">
      <div class="api-code-header">
        <div class="api-code-dot"><span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span></div>
        <div class="api-code-title">POST /api/candidates/search → response</div>
        <button onclick="copyAPISnippet()" style="font-size:11px;font-weight:600;color:#4d9fff;background:rgba(77,159,255,0.1);border:1px solid rgba(77,159,255,0.25);border-radius:6px;padding:3px 10px;cursor:pointer;font-family:inherit;" id="copyAPIBtn">Copy</button>
      </div>
      <div class="api-code-body">
<span class="c-muted">{</span><br>
&nbsp;&nbsp;<span class="c-key">"ok"</span><span class="c-muted">:</span> <span class="c-bool">true</span><span class="c-muted">,</span><br>
&nbsp;&nbsp;<span class="c-key">"score"</span><span class="c-muted">:</span> <span class="c-num">94</span><span class="c-muted">,</span><br>
&nbsp;&nbsp;<span class="c-key">"tier"</span><span class="c-muted">:</span> <span class="c-tier">"gold"</span><span class="c-muted">,</span><br>
&nbsp;&nbsp;<span class="c-key">"tier_label"</span><span class="c-muted">:</span> <span class="c-str">"The Perfect Soul"</span><span class="c-muted">,</span><br>
&nbsp;&nbsp;<span class="c-key">"adaptability"</span><span class="c-muted">:</span> <span class="c-num">91</span><span class="c-muted">,</span><br>
&nbsp;&nbsp;<span class="c-key">"focus_penalty"</span><span class="c-muted">:</span> <span class="c-num">-4</span><span class="c-muted">,</span><br>
&nbsp;&nbsp;<span class="c-key">"silent_skill"</span><span class="c-muted">:</span> <span class="c-str">"Systems thinking"</span><span class="c-muted">,</span><br>
&nbsp;&nbsp;<span class="c-key">"ai_analysis"</span><span class="c-muted">:</span> <span class="c-str">"Trajectory from research<br>&nbsp;&nbsp;&nbsp;to production ML is rare..."</span><span class="c-muted">,</span><br>
&nbsp;&nbsp;<span class="c-key">"api_overhead_ms"</span><span class="c-muted">:</span> <span class="c-num">35</span><br>
<span class="c-muted">}</span>
      </div>
    </div>
  </div>
</section>

<!-- LIVE DEMO -->
<section id="demo" class="demo-section section-fog section-stars">
  <div class="demo-inner">
    <p class="section-eyebrow">Live Demo</p>
    <h2 class="section-heading" style="margin-bottom:12px;">See the engine think</h2>
    <p class="section-sub">A real GPT-4o evaluation — the exact output the engine produces for a candidate against a role.</p>
    <div class="demo-box">
      <div style="margin-bottom:18px;">
        <div class="demo-field">
          <label>Sample job description</label>
          <textarea id="demoJD" readonly style="height:110px;">Senior Backend Engineer to own our payments platform. 6+ years building high-throughput distributed systems in Python or Go, deep PostgreSQL, event-driven architecture (Kafka), and production cloud experience (AWS/Azure/GCP). Bonus: fintech/payments background and a track record of reducing latency at scale.</textarea>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:rgba(29,110,245,0.06);border:1px solid rgba(29,110,245,0.18);border-radius:10px;font-size:13px;color:rgba(200,220,255,0.7);line-height:1.5;margin-bottom:18px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#0a66c2"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        <span>Our GPT-4o engine scores each candidate against your role — Gold, Silver, Bronze — with the reasoning behind every match. Live candidate sourcing (Apollo) is coming soon.</span>
      </div>
      <button class="demo-run-btn" id="demoBtn" onclick="runDemo()">Show a sample evaluation →</button>
      <div class="demo-result" id="demoResult">
        <div class="demo-result-grid">
          <div class="demo-score-circle" id="demoScoreCircle">—</div>
          <div>
            <div style="font-size:13px;color:var(--g-muted);margin-bottom:4px;">Overall Fit Score</div>
            <div style="font-size:18px;font-weight:700;color:#fff;" id="demoTier">—</div>
            <div class="demo-result-dims" id="demoDims"></div>
          </div>
        </div>
        <div class="demo-just" id="demoJust"></div>
      </div>
    </div>
  </div>
</section>

<!-- PRICING -->
<section id="pricing" class="pricing-section section-fog section-stars">
  <div class="pricing-hero fade-in-up">
    <h2 class="pricing-title">Pricing Plans</h2>
    <p class="pricing-sub">Flexible plans that grow with your team</p>
    <p class="pricing-sub2">Real-time AI scoring powered by GPT-4o on Azure</p>

    <!-- What one search includes — paragraph style -->
    <p style="font-size:16px;color:rgba(255,255,255,0.55);line-height:1.8;max-width:560px;margin:16px auto 28px;">
      Every search scores your candidates with GPT-4o — ranked Gold, Silver, Bronze, with the reasoning behind each match — and drafts a personalised outreach message for each one, ready for you to copy and send. Automated LinkedIn sending, reply monitoring, and CRM sync are on the roadmap.
    </p>
    <div class="billing-toggle">
      <button class="toggle-btn" id="monthlyBtn" onclick="setBilling('monthly')">Monthly</button>
      <button class="toggle-btn active" id="annualBtn" onclick="setBilling('annual')">Annual <span class="discount-badge">10% off</span></button>
    </div>
  </div>
  <div class="plans-grid">
    <div class="plan-card">
      <div class="plan-name">Free Trial</div>
      <div class="plan-trial-badge">7-Day Access</div>
      <div class="plan-divider"></div>
      <div class="plan-price"><sup>$</sup>0 <span class="per">for 7 days</span></div>
      <div class="plan-price-sub">Trials the Business plan · card required · then $89/mo</div>
      <ul class="plan-features">
        <li><span class="check-icon">✓</span> Full Business plan for 7 days</li>
        <li><span class="check-icon">✓</span> AI candidate scoring</li>
        <li><span class="check-icon">✓</span> Personalised outreach messages</li>
        <li><span class="check-icon">✓</span> Gold / Silver / Bronze ranking</li>
        <li><span class="check-icon">✓</span> Cancel before day 7 — no charge</li>
      </ul>
      <button class="plan-btn btn-blue" onclick="openPaddleCheckout('business')">Start 7-Day Trial</button>
      <div style="font-size:11px;color:rgba(255,255,255,0.3);text-align:center;margin-top:10px;">Card required. Free for 7 days, then $89/mo. Cancel anytime before day 7.</div>
    </div>
    <div class="plan-card popular">
      <div class="popular-badge">MOST POPULAR</div>
      <div class="plan-name">Business</div>
      <div class="plan-divider"></div>
      <div class="plan-price" id="businessPrice"><sup>$</sup>89<span class="per">/mo</span></div>
      <div class="plan-price-sub" id="businessSub">Billed monthly or annually</div>
      <ul class="plan-features">
        <li><span class="check-icon">✓</span> 5 users</li>
        <li><span class="check-icon">✓</span> 5 searches / month</li>
        <li><span class="check-icon">✓</span> Full AI scoring engine</li>
        <li><span class="check-icon">✓</span> Personalised outreach per candidate</li>
        <li><span class="check-icon">✓</span> Reply monitoring + HR notification</li>
        <li><span class="check-icon">✓</span> CRM sync (coming soon)</li>
        <li><span class="check-icon">✓</span> Team collaboration</li>
