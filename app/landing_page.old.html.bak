<script>
/* Scroll handler — hides brand text on scroll, logo always shows */
let _lastScrolled = null;
window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 80;
    if (scrolled === _lastScrolled) return;
    _lastScrolled = scrolled;
    const bt = document.getElementById('nav-brand-text');
    if (bt) {
        bt.style.opacity = scrolled ? '0' : '1';
        bt.style.pointerEvents = scrolled ? 'none' : 'auto';
    }
}, { passive: true });

function escapeHTML(str) {
    return str.replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
}

function showToast(msg, type = '') {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.className = `toast ${type} show`;
    setTimeout(() => { toast.className = `toast ${type}`; }, 3000);
}

function copyAPISnippet() {
    const snippet = `POST https://aitmp.io/api/candidates/search\nContent-Type: application/json\n\n{\n  "job_description": "Senior ML Engineer...",\n  "role_title": "Senior ML Engineer"\n}\n\n// Response:\n{\n  "ok": true,\n  "score": 94,\n  "tier": "gold",\n  "tier_label": "The Perfect Soul",\n  "adaptability": 91,\n  "focus_penalty": -4,\n  "silent_skill": "Systems thinking",\n  "ai_analysis": "Trajectory from research to production ML is rare...",\n  "api_overhead_ms": 35\n}`;
    navigator.clipboard.writeText(snippet).then(() => {
        const btn = document.getElementById('copyAPIBtn');
        if (btn) { btn.textContent = '✓ Copied!'; btn.style.color = '#00d68f'; setTimeout(() => { btn.textContent = 'Copy'; btn.style.color = '#4d9fff'; }, 2000); }
        showToast('API snippet copied!', 'success');
    });
}

function acceptCookies() { localStorage.setItem('cookies','accepted'); document.getElementById('cookieBanner').classList.remove('show'); showToast('Preferences saved', 'success'); }
function declineCookies() { localStorage.setItem('cookies','declined'); document.getElementById('cookieBanner').classList.remove('show'); }
/* Fix 2 — Safe DOMContentLoaded wrapper prevents timing errors */
document.addEventListener('DOMContentLoaded', () => {
    if (!localStorage.getItem('cookies')) {
        setTimeout(() => {
            const banner = document.getElementById('cookieBanner');
            if (banner) banner.classList.add('show');
        }, 2000);
    }
    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = new Date().getFullYear();
});

const fadeEls = document.querySelectorAll('.fade-in-up');
const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => { if (entry.isIntersecting) { setTimeout(() => entry.target.classList.add('visible'), i * 80); observer.unobserve(entry.target); } });
}, { threshold: 0.15 });
fadeEls.forEach(el => observer.observe(el));

let billing = 'annual';
const prices = { business: {monthly:89,annual:89}, corporate: {monthly:299,annual:269} };

function setBilling(type) {
    billing = type;
    document.getElementById('monthlyBtn').classList.toggle('active', type==='monthly');
    document.getElementById('annualBtn').classList.toggle('active', type==='annual');
    document.getElementById('businessPrice').innerHTML = `<sup>$</sup>${prices.business[type]}<span class="per">/mo</span>`;
    document.getElementById('corporatePrice').innerHTML = `<sup>$</sup>${prices.corporate[type]}<span class="per">/mo</span>`;
    document.getElementById('businessSub').textContent = 'Billed monthly or annually';
    document.getElementById('corporateSub').textContent = type==='annual' ? 'Billed annually — save 10%' : 'Billed monthly';
}

// Billing is consolidated on Paddle — all upgrades go through the Paddle checkout.
function upgrade(plan) {
    if (typeof openPaddleCheckout === 'function') { openPaddleCheckout(plan); }
    else { window.location.href = '/register'; }
}

function contactSales() { window.location.href = 'mailto:hello@aitmp.io?subject=Enterprise%20Plan%20Inquiry%20-%20AI%20Talent%20Match%20Pro&body=Hi%2C%0A%0AI%27m%20interested%20in%20the%20Enterprise%20plan%20for%20AI%20Talent%20Match%20Pro.%0A%0ACompany%20name%3A%20%0ATeam%20size%3A%20%0ACurrent%20ATS%2FCRM%3A%20%0AWhat%20I%27m%20looking%20for%3A%20%0A%0ABest%20time%20to%20reach%20me%3A%20'; }

async function saveSubscriber(email, source) {
    // Real capture — stored server-side (was previously discarded).
    const res = await fetch('/api/subscribe', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, source: source })
    });
    if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error(e.detail || 'Subscribe failed'); }
    return res.json();
}

async function notifyMe() {
    const field = document.getElementById('mobileEmail');
    const email = field.value.trim();
    if (!email) { showToast("Please enter your email", "error"); return; }
    const btn = document.getElementById('notifyBtn');
    try {
        await saveSubscriber(email, 'mobile_app');
        field.value = '';
        if (btn) { btn.textContent = '✓ Done!'; btn.style.background = '#00d68f'; setTimeout(() => { btn.textContent = 'Notify Me'; btn.style.background = '#2563eb'; }, 3000); }
        showToast("You're on the list — we'll email you when the app launches.", "success");
    } catch (e) { showToast(e.message || "Couldn't save your email — try again.", "error"); }
}

async function subscribeEmail() {
    const input = document.querySelector('footer input[type="email"]');
    if (!input || !input.value.trim()) { showToast('Please enter your email', 'error'); return; }
    try {
        await saveSubscriber(input.value.trim(), 'newsletter');
        input.value = '';
        showToast("Thanks — you're subscribed.", 'success');
    } catch (e) { showToast(e.message || "Couldn't subscribe — try again.", 'error'); }
}

function demoUnavailable(msg) {
    document.getElementById('demoScoreCircle').textContent = '—';
    document.getElementById('demoTier').textContent = 'Live scoring is warming up';
    document.getElementById('demoJust').textContent = msg || 'Our GPT-4o engine is momentarily unavailable. Sign up to score your own candidates.';
    document.getElementById('demoDims').innerHTML = '';
    document.getElementById('demoResult').classList.add('visible');
}
async function runDemo() {
    const btn = document.getElementById('demoBtn');
    btn.disabled = true; btn.textContent = 'Scoring…';
    try {
        // Real GPT-4o example (computed once server-side, then cached). No fabricated numbers.
        const res = await fetch('/api/demo/example');
        const data = await res.json();
        if (!data || !data.ok) { demoUnavailable(); return; }
        const score = data.match_score, adaptability = data.adaptability, focus_penalty = data.focus_penalty;
        const net = Math.max(0, score - focus_penalty);
        const tier = data.tier === 'gold' ? '🥇 Gold — Strong Match'
                   : data.tier === 'silver' ? '🥈 Silver — Solid Match'
                   : '🥉 Bronze — Adjacent Match';
        document.getElementById('demoScoreCircle').textContent = score;
        document.getElementById('demoTier').textContent = tier;
        const analysis = (data.ai_analysis || 'Evaluation generated by our live GPT-4o scoring engine.');
        document.getElementById('demoJust').innerHTML =
            `<div style="font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#4a90ff;margin-bottom:6px;">Real GPT-4o example · ${data.role || ''} · sign up to score your own</div>"${analysis}"`;
        document.getElementById('demoDims').innerHTML = `<div class="demo-dim-chip"><div class="chip-lbl">Adaptability</div><div class="chip-val">${adaptability}</div></div><div class="demo-dim-chip"><div class="chip-lbl">Focus Penalty</div><div class="chip-val">-${focus_penalty}</div></div><div class="demo-dim-chip"><div class="chip-lbl">Net Score</div><div class="chip-val">${net}</div></div>`;
        document.getElementById('demoResult').classList.add('visible');
    } catch(e) {
        demoUnavailable();
    } finally {
        btn.disabled = false;
        btn.textContent = 'Show a sample evaluation →';
    }
}
</script>

<!-- COOKIE BANNER -->
<div class="cookie-banner" id="cookieBanner" role="dialog" aria-label="Cookie consent">
  <p class="cookie-text">We use cookies to improve your experience and analyse site usage. Read our <a href="/privacy">Privacy Policy</a> to learn more.</p>
  <div class="cookie-btns">
    <button class="cookie-decline" onclick="declineCookies()">Decline</button>
    <button class="cookie-accept" onclick="acceptCookies()">Accept All</button>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast" role="alert" aria-live="polite"></div>

<!-- Paddle Billing (sandbox) — checkout wiring. Stripe code above is untouched. -->
<script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
<script>
(function(){
  let ready=false, prices={};
  async function initPaddle(){
    try{
      const cfg = await fetch('/api/paddle/config').then(r=>r.json());
      if(!cfg || !cfg.configured || !window.Paddle) return;
      Paddle.Environment.set(cfg.environment || 'sandbox');
      Paddle.Initialize({ token: cfg.token });
      prices = cfg.prices || {};
      ready = true;
    }catch(e){ /* Paddle not configured yet — buttons show a friendly message */ }
  }
  window.openPaddleCheckout = async function(plan){
    const notify = (m)=>{ (window.showToast ? showToast(m,'') : alert(m)); };
    if(!ready){ notify('Checkout is being set up — please try again in a moment.'); return; }
    const priceId = prices[plan];
    if(!priceId){ notify("That plan isn't available yet."); return; }
    let customData = { plan }, customer;
    try{
      const me = await fetch('/api/me').then(r=>r.ok?r.json():null);
      if(me && me.ok){
        const cid = me.company_id || (me.company && me.company.id);
        if(cid) customData.company_id = cid;
        if(me.email) customer = { email: me.email };
      }
    }catch(e){}
    const opts = { items:[{ priceId, quantity:1 }], customData, settings:{ displayMode:'overlay' } };
    if(customer) opts.customer = customer;
    Paddle.Checkout.open(opts);
  };
  document.addEventListener('DOMContentLoaded', initPaddle);
})();
</script>

</body>
</html>