# Copy to .env and fill with real values. NEVER commit the real .env.
# In production these are set as Azure App Service application settings, not from a file.

# ── Azure OpenAI ──
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://ai-talent-match-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Session (must be a long random string in prod) ──
SESSION_SECRET_KEY=generate-a-long-random-value

# ── Stripe (TEST mode until live is activated) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_1TFDd5JEOljoVrx0eoAVExvJ

# ── Paddle Billing (NEW payment processor — alongside Stripe; sandbox first) ──
PADDLE_ENV=sandbox
# Client-side token for Paddle.js (starts test_ in sandbox). PUBLIC — safe in the browser. Create in Paddle > Developer tools > Authentication.
PADDLE_CLIENT_TOKEN=
# Server-side API key (SECRET) — your sandbox API key:
PADDLE_SANDBOX_API_KEY=
# Notification destination signing secret (endpoint_secret_key), from Paddle > Notifications:
PADDLE_WEBHOOK_SECRET=
# Sandbox price IDs (pri_...) for each plan:
PADDLE_PRICE_BUSINESS=
PADDLE_PRICE_CORPORATE=
# Seller/vendor id (optional, informational):
PADDLE_VENDOR_ID=

# ── LinkedIn "Sign In with LinkedIn using OpenID Connect" ──
# This is a FREE product on any LinkedIn Developer app (developer.linkedin.com/apps) —
# it does NOT need Talent Solutions Partner approval. Add the "Sign In with LinkedIn using
# OpenID Connect" product to your app, then paste the app's credentials here. Sign-in stays
# a graceful "coming soon" notice until BOTH id and secret are set.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URL configured in the LinkedIn app:
LINKEDIN_REDIRECT_URI=https://aitmp.io/auth/linkedin/callback

# ── Apollo (not connected yet) ──
APOLLO_API_KEY=

# ── Email (Resend — transactional email) ──
# Get the key at resend.com. Email is a graceful no-op until this is set.
RESEND_API_KEY=
# Verified sender (must be a domain you've verified in Resend once you go live):
EMAIL_FROM=AI Talent Match Pro <noreply@aitmp.io>
# Base URL used in email links (verification, reset):
APP_BASE_URL=https://aitmp.io
# Hard-gate the workspace behind email verification. Keep FALSE until the aitmp.io domain is
# verified in Resend — otherwise real signups get locked out (onboarding@resend.dev only emails
# the Resend account owner). Flip to true once the domain is verified.
REQUIRE_EMAIL_VERIFICATION=false

# ── Database ──
# Local dev: leave DATABASE_PATH unset — falls back to ./elinor.db
DATABASE_URL=sqlite:///./elinor.db
# Production (Azure App Service): set DATABASE_PATH to persistent storage OUTSIDE wwwroot so it
# survives `--clean` deploys. Set as an App Service application setting, not in a committed file.
# DATABASE_PATH=/home/data/elinor.db

# ── Trial reminder scheduler (day-6 "trial ending" email) ──
# In-process daily sweep runs by default. Set false only if you drive it purely via Azure cron.
ENABLE_TRIAL_SCHEDULER=true
# Shared secret for the external cron entrypoint POST /api/cron/trial-reminders
# (send it as the X-Cron-Secret header). Generate a long random value.
CRON_SECRET=

# ── Environment ──
ENV=development
